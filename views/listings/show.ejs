<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-md-6 offset-md-3">
    <h3>Listing Details</h3>
  </div>

  <div class="card col-md-6 offset-md-3">

   
    <img src="<%= listing.image?.url || listing.image %>" class="card-img-top show-image" alt="Listing_image">

    <div class="card-body">

      <!-- Title -->
      <p><b><%= listing.title %></b></p>

      <!-- Description -->
      <p><%= listing.description %></p>

      <!-- Price -->
      <% if (listing.price) { %>
        <p>Price: ₹<%= listing.price.toLocaleString("en-IN") %></p>
      <% } %>

      <!-- Location -->
      <% if (listing.location) { %>
        <p>Location: <%= listing.location %></p>
      <% } %>

      <!-- Country -->
      <% if (listing.country) { %>
        <p>Country: <%= listing.country %></p>
      <% } %>

    </div>
  </div>

  <!-- Buttons -->
  <div class="col-md-6 offset-md-3 mt-3 mb-5">

    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark text-white">
      Edit
    </a>

    <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" class="d-inline mb-5">
      <button class="btn btn-danger">
        Delete
      </button>
    </form>
    

  </div>
</div>

